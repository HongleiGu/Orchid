# ════════════════════════════════════════════════════════════════════════════
#  Orchid — environment config
#  Copy to .env and fill in your values.
# ════════════════════════════════════════════════════════════════════════════

# ── App ──────────────────────────────────────────────────────────────────────
APP_ENV=development

# ── Deployment target ────────────────────────────────────────────
# APP_ENV is the application's own mode (logging, debug behaviour).
# The mirror switch below is deliberately SEPARATE, because the axis that
# matters for package mirrors is NETWORK LOCATION, not dev vs prod: a Hong
# Kong or overseas server wants upstream registries exactly like your laptop,
# while only a mainland-China host wants the Aliyun chain.
#
# Defaults everywhere (base docker-compose.yml) are upstream-first.
# For a mainland-China host, uncomment the line below to layer on Aliyun-first
# chains for pip / apt / npm / node. On Linux the separator is ':' -- it is ';'
# on Windows, since ':' would clash with drive letters.
#
# COMPOSE_FILE=docker-compose.yml:docker-compose.cn.yml
#
# Docker's own IMAGE registry mirror cannot be set from here: it lives in the
# host's /etc/docker/daemon.json. Outside the mainland, leave it unset so pulls
# go straight to Docker Hub.

APP_LOG_LEVEL=INFO
# Must include the public origin once served over HTTPS, e.g.
#   APP_CORS_ORIGINS=https://www.dotslash.cn
APP_CORS_ORIGINS=http://localhost:3000

# ── Ports (used by docker-compose) ──────────────────────────────────────────
BACKEND_PORT=8000
FRONTEND_PORT=3000

# ── Package mirrors ─────────────────────────────────────────────────────────
# Ordered chains, highest priority first — each entry is tried in turn and the
# first that works wins. Defaults (baked into docker-compose) are CN-first:
# Aliyun -> Tsinghua -> upstream. Set these only to override that order, e.g.
# to put upstream first when building outside mainland China.
# These feed both the Docker build args AND the container environment, because
# the marketplace (npm) and skill-runner /install-deps (pip) install at runtime.
#
# PIP_INDEX_URLS="https://pypi.org/simple https://mirrors.aliyun.com/pypi/simple/"
# PIP_INDEX_URL must be the FIRST entry of PIP_INDEX_URLS — it is the
# single-value fallback for tools that only understand the conventional name.
# PIP_INDEX_URL=https://pypi.org/simple
# APT_MIRRORS="deb.debian.org mirrors.aliyun.com"
# NODE_MIRRORS replace deb.nodesource.com, which has no CN mirror. If every
# entry fails the build falls back to nodesource itself.
# NODE_MIRRORS="https://mirrors.aliyun.com/nodejs-release https://mirrors.tuna.tsinghua.edu.cn/nodejs-release"
# NPM_REGISTRIES="https://registry.npmjs.org https://registry.npmmirror.com"
# NPM_REGISTRY=https://registry.npmjs.org
#
# On Aliyun ECS, the intranet endpoint is faster and does not bill against
# public bandwidth — verify it resolves on the box first. It is plain HTTP,
# which the build handles by adding --trusted-host for http:// indexes only.
# PIP_INDEX_URLS="http://mirrors.cloud.aliyuncs.com/pypi/simple/ https://pypi.tuna.tsinghua.edu.cn/simple"
# PIP_INDEX_URL=http://mirrors.cloud.aliyuncs.com/pypi/simple/
# APT_MIRRORS="mirrors.cloud.aliyuncs.com mirrors.aliyun.com"

# ── Public domain / TLS (nginx + certbot) ────────────────────────
# Only used by the 'prod' compose profile. Set COMPOSE_PROFILES=prod on the
# server so plain `docker compose up -d` starts nginx and certbot too.
# COMPOSE_PROFILES=prod
#
# DOMAIN is the canonical hostname AND names the certbot live/ directory, so
# it must be the first -d passed to certbot. DOMAIN_ALT is an optional second
# name on the same certificate (typically the apex).
# Which nginx config to render: templates-http serves plain HTTP on port 80,
# templates-tls terminates TLS on 443 and redirects 80 to it. Start on http;
# switch to tls only once scripts/init-letsencrypt.sh has issued a cert, or
# nginx will fail to start on a missing certificate file.
NGINX_TEMPLATE_DIR=templates-http
#
# certbot lives in its own 'tls' profile so plain HTTP does not start a
# renewal loop for a cert that does not exist: COMPOSE_PROFILES=prod,tls
#
DOMAIN=localhost
DOMAIN_ALT=
#
# Where Let's Encrypt sends expiry warnings. Required by init-letsencrypt.sh.
CERTBOT_EMAIL=
#
# 1 = staging CA: untrusted certs, but far looser rate limits. Leave at 1
# until issuance succeeds, then set 0 and re-run scripts/init-letsencrypt.sh.
# Production allows only 5 failed attempts per hour for a given domain.
CERTBOT_STAGING=1

# ── Frontend → Backend ──────────────────────────────────────────────────────
# Baked into the client bundle at build time. Behind nginx these become the
# public origin, same-origin with the app, e.g.
#   NEXT_PUBLIC_API_URL=https://www.dotslash.cn
#   NEXT_PUBLIC_WS_URL=wss://www.dotslash.cn
# Changing them needs a frontend image rebuild, not just a restart.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# ── Database ─────────────────────────────────────────────────────────────────
# Dev (SQLite, no Docker needed):
DATABASE_URL=sqlite+aiosqlite:///./agentapp.db
# Docker / production (overridden by docker-compose):
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/agentapp

# ── Redis ────────────────────────────────────────────────────────────────────
# Leave blank for in-process mode (dev only, single worker)
REDIS_URL=
# Docker / production (overridden by docker-compose):
# REDIS_URL=redis://localhost:6379/0

# ── LLM routing ─────────────────────────────────────────────────────────────
LLM_DEFAULT_MODEL=openrouter/openai/gpt-4o-mini
LLM_FALLBACK_MODEL=

# ── LiteLLM tuning ──────────────────────────────────────────────────────────
LITELLM_DROP_PARAMS=true
LITELLM_REQUEST_TIMEOUT=120
LITELLM_MAX_RETRIES=3

# ── Provider API keys (set only what you use) ────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_API_BASE=
GROQ_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_API_BASE=http://localhost:11434

# ── WeChat Official Account (公众号) ─────────────────────────────────────────
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# ── Gmail OAuth (visit /api/v1/gmail/auth after setting these) ──────────────
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=

# ── Tools ────────────────────────────────────────────────────────────────────
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
SERPAPI_API_KEY=
BRAVE_API_KEY=

# ── Scheduler ────────────────────────────────────────────────────────────────
SCHEDULER_TIMEZONE=UTC
SCHEDULER_MAX_CONCURRENT_RUNS=5
