# Plain HTTP. Selected by NGINX_TEMPLATE_DIR in docker-compose.yml; the TLS
# variant lives in nginx/templates-tls/ and is one .env change away once a
# certificate can actually be issued.
#
# Rendered by the nginx image's envsubst entrypoint, with NGINX_ENVSUBST_FILTER
# limiting substitution to DOMAIN* so $host, $request_uri etc. survive.

# Docker's embedded DNS. Paired with the variable-based proxy_pass below, this
# re-resolves upstreams per request instead of caching the IP from startup --
# otherwise redeploying backend or frontend leaves nginx 502ing on a stale
# address, and nginx refuses to start at all if an upstream is briefly missing.
resolver 127.0.0.11 valid=30s ipv6=off;

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    listen [::]:80;
    server_name ${DOMAIN} ${DOMAIN_ALT};

    # Kept even without TLS so scripts/init-letsencrypt.sh can complete later
    # without editing nginx: the challenge must be served over plain HTTP and
    # must not redirect.
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type "text/plain";
    }

    # Vault uploads go through the API.
    client_max_body_size 50m;

    # Backend API. Also carries the run-stream WebSocket at
    # /api/v1/runs/{run_id}/stream, hence the Upgrade headers.
    location /api/ {
        set $upstream_backend http://backend:8000;
        proxy_pass $upstream_backend;
        proxy_http_version 1.1;
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Agent runs stream for minutes; nginx's 60s default would cut them off.
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        # Forward tokens as they arrive instead of buffering the whole response.
        proxy_buffering off;
    }

    location = /health {
        set $upstream_health http://backend:8000;
        proxy_pass $upstream_health;
        access_log off;
    }

    # Next.js (standalone server), including /_next/* assets.
    location / {
        set $upstream_frontend http://frontend:3000;
        proxy_pass $upstream_frontend;
        proxy_http_version 1.1;
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
