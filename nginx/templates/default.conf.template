# Rendered to /etc/nginx/conf.d/default.conf at container start by the nginx
# image's envsubst entrypoint. NGINX_ENVSUBST_FILTER (see docker-compose.yml)
# restricts substitution to DOMAIN* only, so nginx's own runtime variables
# ($host, $request_uri, ...) pass through untouched.

# Docker's embedded DNS. Paired with the variable-based proxy_pass below, this
# makes nginx re-resolve upstreams per request instead of caching the IP from
# startup. Without it, redeploying backend or frontend gives that container a
# new IP and nginx keeps 502ing on the stale one until reloaded -- and it also
# refuses to start at all if an upstream is briefly missing.
resolver 127.0.0.11 valid=30s ipv6=off;

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# ── HTTP :80 — ACME challenge, everything else redirected to HTTPS ───────────
server {
    listen 80;
    listen [::]:80;
    server_name ${DOMAIN} ${DOMAIN_ALT};

    # Must stay plain HTTP and must NOT redirect: Let's Encrypt fetches the
    # challenge over port 80, and a 301 here breaks issuance and renewal.
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type "text/plain";
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# ── HTTPS :443 ───────────────────────────────────────────────────────────────
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${DOMAIN} ${DOMAIN_ALT};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;

    # Inlined rather than `include options-ssl-nginx.conf`: certbot only writes
    # that file when using its nginx installer, and pulling it from GitHub is
    # unreliable from mainland China.
    ssl_protocols             TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache         shared:SSL:10m;
    ssl_session_timeout       1d;
    ssl_session_tickets       off;

    # HSTS is deliberately left off until HTTPS is proven stable here: browsers
    # cache it for the full max-age and it cannot be revoked, so a bad cert
    # would lock visitors out for a year. Enable once you are confident.
    # add_header Strict-Transport-Security "max-age=31536000" always;

    # Vault uploads go through the API.
    client_max_body_size 50m;

    # Backend API. Also carries the run-stream WebSocket at
    # /api/v1/runs/{run_id}/stream, hence the Upgrade headers.
    location /api/ {
        # Variable (not literal) so the resolver above is consulted per request.
        # No URI part here, so the original request URI passes through intact.
        set $upstream_backend http://backend:8000;
        proxy_pass $upstream_backend;
        proxy_http_version 1.1;
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Agent runs stream for minutes; nginx's 60s default would cut them off.
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        # Forward tokens as they arrive instead of buffering the whole response.
        proxy_buffering off;
    }

    location = /health {
        set $upstream_health http://backend:8000;
        proxy_pass $upstream_health;
        access_log off;
    }

    # Next.js (standalone server), including /_next/* assets.
    location / {
        set $upstream_frontend http://frontend:3000;
        proxy_pass $upstream_frontend;
        proxy_http_version 1.1;
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
